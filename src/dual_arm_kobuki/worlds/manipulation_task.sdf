<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="manipulation_task">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.82 0.87 0.92 1</background>
      <grid>true</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= STARTING BASE =================
         Carries both envelope extremes. Top surface z = 0.20 m.
         Positioned so every pick waypoint stays under 75% of the arm's
         2R envelope - see nodes/arm_kinematics.py reach_fraction().
    -->
    <model name="starting_base">
      <static>true</static>
      <pose>0.41 0.02 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.19 0 0 0</pose>
          <geometry><box><size>0.30 0.28 0.02</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.19 0 0 0</pose>
          <geometry><box><size>0.30 0.28 0.02</size></box></geometry>
          <material>
            <ambient>0.55 0.38 0.22 1</ambient>
            <diffuse>0.70 0.48 0.28 1</diffuse>
          </material>
        </visual>
        <collision name="pedestal_collision">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry><box><size>0.12 0.12 0.18</size></box></geometry>
        </collision>
        <visual name="pedestal_visual">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry><box><size>0.12 0.12 0.18</size></box></geometry>
          <material>
            <ambient>0.30 0.30 0.32 1</ambient>
            <diffuse>0.40 0.40 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= DESTINATION BASE ================= -->
    <model name="destination_base">
      <static>true</static>
      <pose>0.22 0.30 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.19 0 0 0</pose>
          <geometry><box><size>0.24 0.24 0.02</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.19 0 0 0</pose>
          <geometry><box><size>0.24 0.24 0.02</size></box></geometry>
          <material>
            <ambient>0.22 0.42 0.30 1</ambient>
            <diffuse>0.30 0.58 0.40 1</diffuse>
          </material>
        </visual>
        <collision name="pedestal_collision">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry><box><size>0.10 0.10 0.18</size></box></geometry>
        </collision>
        <visual name="pedestal_visual">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry><box><size>0.10 0.10 0.18</size></box></geometry>
          <material>
            <ambient>0.30 0.30 0.32 1</ambient>
            <diffuse>0.40 0.40 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         ENVELOPE EXTREME 1: SMALLEST OBJECT  -  5 cm dia, 5 cm tall
         0.08 kg. Single-arm jaw grasp: fits the 7.0 cm opening with
         2 cm margin. THIS is the pick-and-place demo object.
         ============================================================ -->
    <model name="object_min">
      <pose>0.31 0.09 0.225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.0000292</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0000292</iyy><iyz>0</iyz>
            <izz>0.0000250</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.050</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.6</mu><mu2>1.6</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.050</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.45 0.55 1</ambient>
            <diffuse>0.20 0.62 0.74 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         ENVELOPE EXTREME 2: LARGEST OBJECT  -  18 cm dia, 25 cm tall
         0.50 kg = the payload ceiling. NOT part of the pick-and-place
         demo: 18 cm exceeds the 7 cm jaw opening, so it is the bimanual
         co-manipulation case, which is blocked on the convergence
         question (see README section 9).
         ============================================================ -->
    <model name="object_max">
      <pose>0.44 0.02 0.325 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.50</mass>
          <inertia>
            <ixx>0.003617</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.003617</iyy><iyz>0</iyz>
            <izz>0.002025</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.090</radius><length>0.250</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.6</mu><mu2>1.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.090</radius><length>0.250</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.35 0.10 1</ambient>
            <diffuse>0.82 0.54 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
