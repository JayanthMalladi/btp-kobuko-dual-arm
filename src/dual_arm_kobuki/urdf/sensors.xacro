<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================================================================
       SENSOR MAST - two posts at r = 14 cm from O [POSTER].
       Camera and LiDAR heights are driven by camera_height_agl and
       lidar_height_agl in common.xacro, measured from GROUND LEVEL, not
       from the deck. Change those two numbers and everything follows.
       ================================================================== -->

  <xacro:macro name="mast_post" params="name y">
    <joint name="${name}_fixed" type="fixed">
      <parent link="top_deck"/>
      <child  link="${name}"/>
      <origin xyz="${mast_offset_x} ${y} ${deck_thickness/2.0}" rpy="0 0 0"/>
    </joint>
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${mast_height/2.0}"/>
        <geometry><cylinder radius="${mast_radius}" length="${mast_height}"/></geometry>
        <material name="deck_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${mast_height/2.0}"/>
        <geometry><cylinder radius="${mast_radius}" length="${mast_height}"/></geometry>
      </collision>
      <xacro:cylinder_inertial mass="${mast_mass}" radius="${mast_radius}" length="${mast_height}">
        <origin xyz="0 0 ${mast_height/2.0}"/>
      </xacro:cylinder_inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="sensor_mast">

    <xacro:mast_post name="mast_left"  y="${mast_offset_y}"/>
    <xacro:mast_post name="mast_right" y="${-mast_offset_y}"/>

    <!-- Crossbar joining the posts. Its centre sits at mast_head_agl. -->
    <joint name="mast_head_fixed" type="fixed">
      <parent link="mast_left"/>
      <child  link="mast_head"/>
      <origin xyz="0 ${-mast_offset_y} ${mast_height}" rpy="0 0 0"/>
    </joint>
    <link name="mast_head">
      <visual>
        <geometry><box size="0.03 ${2*mast_offset_y} 0.025"/></geometry>
        <material name="deck_grey"/>
      </visual>
      <collision>
        <geometry><box size="0.03 ${2*mast_offset_y} 0.025"/></geometry>
      </collision>
      <xacro:box_inertial mass="0.10" x="0.03" y="${2*mast_offset_y}" z="0.025">
        <origin xyz="0 0 0"/>
      </xacro:box_inertial>
    </link>

    <!-- ========== RGB camera: 46 cm AGL, pitched 23 deg down ========== -->
    <joint name="camera_fixed" type="fixed">
      <parent link="mast_head"/>
      <child  link="camera_link"/>
      <origin xyz="0.025 0 ${camera_z_off}" rpy="0 0.40 0"/>
    </joint>
    <link name="camera_link">
      <visual>
        <geometry><box size="0.02 0.05 0.02"/></geometry>
        <material name="sensor_red"/>
      </visual>
      <xacro:box_inertial mass="0.03" x="0.02" y="0.05" z="0.02">
        <origin xyz="0 0 0"/>
      </xacro:box_inertial>
    </link>

    <!-- ========== 2D LiDAR: 32 cm AGL, level ==========
         Mounted on a short drop bracket from the crossbar. -->
    <joint name="lidar_bracket_fixed" type="fixed">
      <parent link="mast_head"/>
      <child  link="lidar_bracket"/>
      <origin xyz="0 0 ${lidar_z_off/2.0}" rpy="0 0 0"/>
    </joint>
    <link name="lidar_bracket">
      <visual>
        <geometry><box size="0.016 0.016 ${-lidar_z_off}"/></geometry>
        <material name="deck_grey"/>
      </visual>
      <xacro:box_inertial mass="0.02" x="0.016" y="0.016" z="${-lidar_z_off}">
        <origin xyz="0 0 0"/>
      </xacro:box_inertial>
    </link>

    <joint name="lidar_fixed" type="fixed">
      <parent link="mast_head"/>
      <child  link="lidar_link"/>
      <origin xyz="0 0 ${lidar_z_off}" rpy="0 0 0"/>
    </joint>
    <link name="lidar_link">
      <visual>
        <geometry><cylinder radius="0.033" length="0.035"/></geometry>
        <material name="sensor_red"/>
      </visual>
      <xacro:cylinder_inertial mass="0.12" radius="0.033" length="0.035">
        <origin xyz="0 0 0"/>
      </xacro:cylinder_inertial>
    </link>

    <!-- ================= GAZEBO HARMONIC SENSOR DEFINITIONS ================= -->

    <gazebo reference="camera_link">
      <sensor name="rgb_camera" type="camera">
        <topic>camera/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>12.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

    <gazebo reference="lidar_link">
      <sensor name="lidar_2d" type="gpu_lidar">
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
