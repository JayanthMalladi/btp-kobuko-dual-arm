<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================================================================
       KOBUKI-CLASS BASE
       Modelled with primitives only - no external meshes, no dependency on
       kobuki_description. Correct radius, height and mass; the hex deck is
       drawn as a disc of the same circumradius (see README, "Known
       simplifications").
       ================================================================== -->

  <xacro:macro name="kobuki_base">

    <!-- base_footprint sits on the ground; base_link is the body centre -->
    <link name="base_footprint"/>

    <joint name="base_footprint_to_base_link" type="fixed">
      <parent link="base_footprint"/>
      <child  link="base_link"/>
      <origin xyz="0 0 ${ground_clearance + base_height/2.0}" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
        <material name="kobuki_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      </collision>
      <xacro:cylinder_inertial mass="${base_mass}" radius="${base_radius}" length="${base_height}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:cylinder_inertial>
    </link>

    <!-- Front marker so orientation is obvious in the GUI -->
    <joint name="base_to_front_marker" type="fixed">
      <parent link="base_link"/>
      <child  link="front_marker"/>
      <origin xyz="${base_radius - 0.01} 0 ${base_height/2.0 - 0.005}" rpy="0 0 0"/>
    </joint>
    <link name="front_marker">
      <visual>
        <geometry><box size="0.02 0.06 0.008"/></geometry>
        <material name="sensor_red"/>
      </visual>
      <xacro:box_inertial mass="0.01" x="0.02" y="0.06" z="0.008">
        <origin xyz="0 0 0"/>
      </xacro:box_inertial>
    </link>

    <!-- ========== Top deck ========== -->
    <joint name="base_to_deck" type="fixed">
      <parent link="base_link"/>
      <child  link="top_deck"/>
      <!-- deck top surface lands exactly at deck_top_z above the ground -->
      <origin xyz="0 0 ${deck_top_z - deck_thickness/2.0 - (ground_clearance + base_height/2.0)}" rpy="0 0 0"/>
    </joint>

    <link name="top_deck">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="${deck_radius}" length="${deck_thickness}"/></geometry>
        <material name="deck_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="${deck_radius}" length="${deck_thickness}"/></geometry>
      </collision>
      <xacro:cylinder_inertial mass="${deck_mass}" radius="${deck_radius}" length="${deck_thickness}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:cylinder_inertial>
    </link>

  </xacro:macro>

</robot>
